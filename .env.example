# Diese Datei nach `.env` kopieren und Werte eintragen: cp .env.example .env
# `.env` wird von Docker Compose (env_file) und lokal (DotEnv-Loader) gelesen und sollte NICHT
# eingecheckt werden. Doppelte Unterstriche (__) entsprechen verschachtelten Konfigurationsschlüsseln,
# z. B. ConnectionStrings__DefaultConnectionString => ConnectionStrings:DefaultConnectionString.

# Connection-String zur Uni-Datenbank (vom Lehrstuhl bereitgestellt):
ConnectionStrings__DefaultConnectionString=Server=<uni-host>;Database=<db>;User Id=<user>;Password=<passwort>;TrustServerCertificate=True

# JWT-Signing-Key – mindestens 32 Zeichen:
AccessToken__Key=EinGeheimerJwtSchluesselMitMindestens32Zeichen!

# Brevo API-Key für den E-Mail-Versand (nur für echten Versand nötig):
Brevo__ApiKey=xkeysib-ihr-brevo-api-key
