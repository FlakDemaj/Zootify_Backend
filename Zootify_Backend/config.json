{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "OverrideConnectionString": ""
  },
  "AccessToken": {
    "Issuer": "Zootify-Server",
    "Audience": "Zootify-Client",
    "Key": "",
    "ExpiresInMinutes": 30
  },
  "Brevo":
  {
    "Email": "zootify@gmx.de",
    "SenderName": "Zootify",
    "ApiKey": ""
  },
  "General":
  {
    "MinimumPasswordLength": 8,
    "MaximumLoginAttempts": 5,
    "FrontendBaseUrl": "http://localhost:4200",
    "SpecialCharacters": "!@#$%^&*()_+-=[]{}|;:',.<>?",
    "RegistrationTokenExpiryInHours": 24,
    "ResetPasswordTokenExpiryInHours": 24
  },
  "CleanupJobs": {
    "IntervalInHours": 12,
    "RetentionYears": 2,
    "BatchSize": 100
  },
  "LoanReminderJob": {
    "IntervalInHours": 12,
    "BatchSize": 50,
    "Stage1Days": 7,
    "Stage2Days": 4,
    "Stage3Days": 1
  },
  "RejectedSpecimenPurgeJob": {
    "IntervalInHours": 12,
    "RetentionDays": 14,
    "BatchSize": 100
  }
}
